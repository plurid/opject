{
    "name": "opject",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.3.0",
    "engines": {
        "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
    },
    "scripts": {
        "build": "pnpm -r build",
        "dev": "pnpm -r --parallel dev",
        "clean": "pnpm -r clean",
        "lint": "eslint . --max-warnings 0",
        "typecheck": "pnpm -r typecheck && tsc --project tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "check:packages": "pnpm -r check:package && node scripts/check-packages.mjs",
        "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:packages",
        "python:check": "uv run --locked --all-packages ruff check packages/python && uv run --locked --all-packages pytest",
        "python:build": "uv build --all-packages --no-sources",
        "check:all": "pnpm check && pnpm python:check && pnpm python:build"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/cross-spawn": "6.0.6",
        "@types/node": "22.20.4",
        "cross-spawn": "7.0.6",
        "eslint": "10.11.0",
        "globals": "17.12.0",
        "publint": "0.3.24",
        "tsdown": "0.23.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.1",
        "vitest": "5.0.1"
    }
}
