{
    "name": "@plurid/opject-server",
    "version": "0.0.0-1",
    "description": "Server for Object Passing",
    "keywords": [
        "object passing",
        "server"
    ],
    "author": "ly3xqhl8g9 <ly3xqhl8g9@plurid.com> (https://plurid.com)",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurid/opject.git",
        "directory": "packages/javascript/opject-server"
    },
    "bugs": {
        "email": "source@plurid.com",
        "url": "https://github.com/plurid/opject/issues"
    },
    "homepage": "https://github.com/plurid/opject/blob/master/packages/javascript/opject-server",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "files": [
        "distribution"
    ],
    "main": "./distribution/index.cjs",
    "module": "./distribution/index.mjs",
    "engines": {
        "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
    },
    "scripts": {
        "clean": "node -e \"require('node:fs').rmSync('distribution', { recursive: true, force: true })\"",
        "dev": "tsdown --config ../../../tsdown.config.ts --watch",
        "build": "tsdown --config ../../../tsdown.config.ts",
        "typecheck": "tsc --project tsconfig.json",
        "check:package": "publint --strict",
        "prepack": "pnpm build",
        "prepublishOnly": "pnpm --dir ../../.. check"
    },
    "type": "module",
    "types": "./distribution/index.d.mts",
    "exports": {
        ".": {
            "import": {
                "types": "./distribution/index.d.mts",
                "default": "./distribution/index.mjs"
            },
            "require": {
                "types": "./distribution/index.d.cts",
                "default": "./distribution/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "dependencies": {
        "@plurid/deon": "0.0.0-10",
        "@types/express": "^5.0.6",
        "express": "^5.2.1"
    },
    "sideEffects": false
}
